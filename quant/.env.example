# Copy this file to .env and fill it in. .env holds secrets: never share it or upload it.
# Keep THIS file free of real keys - it is meant to be committed.

# ---- Alpaca (required): sign up at https://alpaca.markets, create an API key on the Paper Trading page ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Uncomment for live-trading keys
# ALPACA_TRADING_URL=https://api.alpaca.markets

# ---- Massive (formerly Polygon.io; optional but recommended): free key, identifies common stocks ----
MASSIVE_API_KEY=

# ---- SEC EDGAR (required for fundamental factors): your name and email, the SEC asks clients to identify themselves ----
SEC_USER_AGENT=Your Name your@email.com

# ---- Email (Gmail) ----
# App password: Google account -> Security -> 2-Step Verification (turn on first) -> App passwords, 16 characters
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
# Recipient; empty = send to EMAIL_SENDER
EMAIL_TO=
# 1 = also email on days without a rebalance; 0 = only rebalances, warnings and errors
EMAIL_DAILY=0

# ---- Strategy ----
# Score: wf / equal / ic / lgbm (keep in sync with METHOD in run_daily.bat)
SCORE_METHOD=wf

# ---- Model account and web page ----
# 1 = also run the $100,000 model account (every signal fills at the next open); 0 = off
MODEL_ACCOUNT=1
# Show the real account's dollar amounts on the public page: 1 = yes; 0 = returns and weights only
SITE_SHOW_REAL_AMOUNTS=1
# Which backtest the page shows (middle part of reports/backtest_<name>_nav.csv); empty = newest
SITE_BACKTEST=
